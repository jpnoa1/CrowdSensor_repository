#!/usr/bin/env python3
import time
import lgpio

PIN = 26      # GPIO26
CHIP = 4      # Pi 5 usa gpiochip4

h = lgpio.gpiochip_open(CHIP)

# Entrada com pull-up interno (mantém o pino em 1 quando solto)
lgpio.gpio_claim_input(h, PIN, lgpio.SET_PULL_UP)

print(f"A ler GPIO{PIN} no gpiochip{CHIP}... (CTRL+C para sair)")
try:
    while True:
        val = lgpio.gpio_read(h, PIN)
        print("Pressed" if val == 0 else "Released")
        time.sleep(0.2)
except KeyboardInterrupt:
    pass
finally:
    lgpio.gpiochip_close(h)
    print("\nGPIO fechado.")
