import serial
import time

ports = ["/dev/ttyAMA0", "/dev/ttyS0"]
bauds = [115200, 9600]

for port in ports:
    for baud in bauds:
        print(f"\n[TEST] {port} @ {baud}")
        try:
            ser = serial.Serial(port, baud, timeout=2)
            time.sleep(2)
            ser.reset_input_buffer()
            ser.write(b"AT+NWM=?\r\n")
            time.sleep(1)
            response = ser.read_all().decode(errors='ignore')
            print(f"[RX] {response if response else 'no response'}")
            ser.close()
        except Exception as e:
            print(f"[ERROR] {e}")